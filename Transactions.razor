@page "/transactions"
@rendermode InteractiveServer
@implements IDisposable
@inject IEJHeaderRepository Repository
@inject LegalHoldAdmin.Services.SelectedMemberState SelectedMemberState
@inject NavigationManager Navigation

<h1>Transactions</h1>
<p class="muted">Transaction records from EJHeader table by access number.</p>

@if (!SelectedMemberState.HasSelectedMember)
{
    <section class="card empty-state">
        <h2>Select a member to view transactions</h2>
        <p>Transactions are loaded using the selected member's access number.</p>
        <button type="button" @onclick="OpenMemberSearch">Go to Member Search</button>
    </section>
}
else
{
    <section class="card">
        <h2>Load Table Data</h2>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert @(isError ? "error" : "success")">@message</div>
        }

        <div class="member-select-panel">
            <div>
                <span>Selected member</span>
                <strong>@SelectedMemberState.DisplayName</strong>
            </div>
            <button type="button" class="secondary" @onclick="OpenMemberSearch">Change Member</button>
        </div>

        <div class="toolbar">
            <label>
                Access number
                <input type="text" value="@accessNumber" disabled />
            </label>
            <div></div>
            <button type="button" @onclick="SearchAsync" disabled="@busy">
                @(busy ? "Loading..." : "Load Data")
            </button>
        </div>
    </section>
}

@if (SelectedMemberState.HasSelectedMember && !hasSearched)
{
    <p class="muted">Click Load Data to fetch transactions for the selected member.</p>
}
else if (SelectedMemberState.HasSelectedMember && !busy && !isError && totalCount == 0 && hasSearched)
{
    <p class="muted">No matching transactions were found.</p>
}

<div hidden="@(!SelectedMemberState.HasSelectedMember || !hasSearched || isError)">
    <RadzenDataGrid @ref="grid"
                    Data="@rows"
                    TItem="EJHeaderRecord"
                    Count="@totalCount"
                    LoadData="@LoadDataAsync"
                    IsLoading="@busy"
                    AllowPaging="true"
                    AllowSorting="true"
                    PageSize="10"
                    PageSizeOptions="@(new int[] { 10, 20, 50 })"
                    PagerAlwaysVisible="true">
        <Columns>
            <RadzenDataGridColumn TItem="EJHeaderRecord" Property="TranName" Title="Tran Name" />
            <RadzenDataGridColumn TItem="EJHeaderRecord" Property="EJTime" Title="EJ Time" />
            <RadzenDataGridColumn TItem="EJHeaderRecord" Property="CalendarDate" Title="Calendar Date" />  
            <RadzenDataGridColumn TItem="EJHeaderRecord" Property="AccountNumber" Title="Account Number" />
            <RadzenDataGridColumn TItem="EJHeaderRecord" Property="TranAmount" Title="Tran Amount" />
            <RadzenDataGridColumn TItem="EJHeaderRecord" Property="BeginTime" Title="Begin Time" />
            <RadzenDataGridColumn TItem="EJHeaderRecord" Property="AccessNo" Title="Access No" />
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    private List<EJHeaderRecord> rows = new();
    private RadzenDataGrid<EJHeaderRecord>? grid;
    private string accessNumber = string.Empty;
    private string searchedAccessNumber = string.Empty;
    private string? message;
    private bool isError;
    private bool busy;
    private bool hasSearched;
    private int totalCount;

    protected override void OnInitialized()
    {
        SelectedMemberState.OnChange += OnSelectedMemberChanged;
        ApplySelectedMember();
    }

    private async Task SearchAsync()
    {
        searchedAccessNumber = accessNumber.Trim();
        hasSearched = true;
        message = null;
        isError = false;
        rows.Clear();
        totalCount = 0;

        if (grid is not null)
        {
            await grid.FirstPage(true);
        }
    }

    private async Task LoadDataAsync(LoadDataArgs args)
    {
        if (!hasSearched || string.IsNullOrWhiteSpace(searchedAccessNumber))
        {
            return;
        }

        busy = true;
        message = null;
        isError = false;

        try
        {
            var requestedAccessNumber = searchedAccessNumber;
            var result = await Repository.LoadPageAsync(
                requestedAccessNumber,
                args.Skip ?? 0,
                args.Top ?? 10,
                args.OrderBy);

            if (!string.Equals(accessNumber, requestedAccessNumber, StringComparison.Ordinal))
            {
                return;
            }

            rows = result.Items.ToList();
            totalCount = result.TotalCount;

            var normalizedAccessNumber = searchedAccessNumber.PadLeft(14, '0');
            message = $"Found {totalCount} transaction{(totalCount == 1 ? string.Empty : "s")} for access number {normalizedAccessNumber}.";
        }
        catch (Exception ex)
        {
            rows.Clear();
            totalCount = 0;
            message = ex.Message;
            isError = true;
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenMemberSearch()
    {
        Navigation.NavigateTo("/member-search");
    }

    private void OnSelectedMemberChanged()
    {
        _ = InvokeAsync(() =>
        {
            ApplySelectedMember();
            StateHasChanged();
        });
    }

    private void ApplySelectedMember()
    {
        accessNumber = SelectedMemberState.AccessNumber?.Trim() ?? string.Empty;
        searchedAccessNumber = string.Empty;
        rows.Clear();
        totalCount = 0;
        message = null;
        isError = false;
        hasSearched = false;
    }

    public void Dispose()
    {
        SelectedMemberState.OnChange -= OnSelectedMemberChanged;
    }
}
